// Clone trooper playermodel material (BF2 textures, converted). Tint mask = battalion markings (battalion_markings.py).

Layer0
{
	shader "shaders/complex.shader"

	F_MORPH_SUPPORTED 1
	F_TINT_MASK 1

	g_flModelTintAmount "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 0.000000]"
	TextureColor "models/clones/textures/clone_helmet_color.png"
	TextureNormal "models/clones/textures/clone_helmet_normal.png"
	TextureRoughness "models/clones/textures/clone_helmet_rough.png"
	g_flRoughnessScaleFactor "1.000"
	TextureAmbientOcclusion "materials/default/default_ao.tga"
	TextureTintMask "models/clones/textures/clone_helmet_tint.png"
	g_flMetalness "0.000"
	g_bFogEnabled "1"
}
