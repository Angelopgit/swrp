
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated code editor files
.vs/*
.vscode/*
*.csproj
obj
bin
Properties/*
code/obj/*
code/Properties/*

# Auto-generated asset related files
.sbox/*
*.generated.*
*.*_c
!*.shader_c
*.los
*.vpk
*launchSettings.json
*.sln
*.slnx

*idea

# Exported / standalone games
Exports/

# Python caches
__pycache__/
*.pyc

# Third-party sbox.game libraries (reinstall from sbox.game; not ours to redistribute)
Libraries/

# Backups and build caches
_backups/
*.bak
*.tar
*.zip
